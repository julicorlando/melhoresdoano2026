# Preenchidas automaticamente pela integração Upstash Redis da Vercel
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (alternativa) UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN

# Senha da página /admin (se não definida, usa a padrão do projeto)
ADMIN_PASSWORD=

# Opcional: "true" para bloquear votos fora do período 23/11 a 30/11/2026
ENFORCE_VOTING_DATES=
